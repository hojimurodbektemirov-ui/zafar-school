# ===== Zafar International School — server sozlamalari =====
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.

NODE_ENV=production
PORT=3000

# Admin panel (/admin). Birinchi ishga tushishda shu login-parol bilan admin yaratiladi.
# Keyin parolni admin paneldagi "Sozlamalar"dan o'zgartirasiz.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bu-yerga-kuchli-parol-yozing

# Sessiya kaliti: uzun tasodifiy satr. Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Telegram bot: yangi arizalar shu chatga keladi.
# 1) @BotFather -> /newbot -> tokenni oling.
# 2) Botni @ZISaloqa yoki xodimlar guruhiga qo'shing, guruhga bitta xabar yozing.
# 3) https://api.telegram.org/bot<TOKEN>/getUpdates ochib, "chat":{"id": ...} raqamini oling (guruhda manfiy bo'ladi).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram kanal importi (yangiliklar uchun)
TG_CHANNEL=zafar_international_school
IMPORT_INTERVAL_MIN=30        # 0 = o'chiq, faqat admin paneldan qo'lda
IMPORT_AUTO_PUBLISH=false     # true = yangi postlar darhol saytga chiqadi

# Server nginx/Cloudflare ortida bo'lsa true qiling (to'g'ri IP va rate-limit uchun)
TRUST_PROXY=false

# Admin cookie faqat HTTPS orqali yuboriladi (tavsiya). Sayt hali HTTPS'siz bo'lsa vaqtincha false qiling.
COOKIE_SECURE=true

# Ma'lumotlar papkasi (baza va yuklangan rasmlar). Zaxira nusxa olishni unutmang!
DATA_DIR=data
